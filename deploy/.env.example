# Copy to deploy/.env (never committed) and fill in.

# The host reviewers open; Caddy gets its certificate for it.
REVIEW_HOST=review.example.com
PUBLIC_ORIGIN=https://review.example.com

# The app's key to the owner API: `openssl rand -base64 32`.
ADMIN_TOKEN=

# Outgoing mail (magic links, invites). Scaleway Transactional Email keeps mail data in the EU;
# Amazon SES in eu-central-1 does too. Leave both empty to log mail instead of sending it.
SMTP_URL=smtps://PROJECT_ID:SECRET_KEY@smtp.tem.scw.cloud:465
MAIL_FROM=Review <review@example.com>

# Cloudflare Turnstile on the sign-in and join forms (both or neither).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# The daily digest's hour (UTC) and how long a closed project is kept (days).
DIGEST_HOUR=7
RETENTION_DAYS=90

# Where Litestream keeps the database replica (an S3-compatible bucket, EU region).
LITESTREAM_BUCKET=designcraft-review
LITESTREAM_ENDPOINT=https://fsn1.your-objectstorage.com
LITESTREAM_REGION=fsn1
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

RUST_LOG=info
